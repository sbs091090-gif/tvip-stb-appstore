# Copy to .env; generate distinct secret values locally. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-password
DJANGO_SECRET_KEY=replace-with-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8080
HTTP_BIND=127.0.0.1
# For builds in this managed environment; normally the OS CA bundle is suitable.
BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
